# Создаем новый .gitignore
cat > .gitignore << EOF
# IDE
.vscode/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
addonmounter/

# Build artifacts
build/
dist/
*.spec

# Development tools
alt_vpk_extractor/
aniversary_gameinfos/
debug_pages/
other/

# Debug / test files
.freebuff/
addon_1_collection.json
addon_1_published.json
addon_2_collection.json
addon_2_published.json
collection_result.json
api_request_test.py
wokrshopextender.md
workshop_000.vpk
workshop_dir.vpk

# Images and assets
*.jpg
*.png
*.xcf

# Configuration
config.json

# Keep these
!icon.ico
!requirements.txt
EOF